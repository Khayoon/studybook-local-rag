# Copy to .env. No model server is started or contacted at application startup.
STUDYBOOK_BASE_URL=http://127.0.0.1:8090/v1
# Replace with the actual model identifier exposed by your local server.
STUDYBOOK_MODEL=local-model
STUDYBOOK_API_KEY=local-only
# lexical = offline hashed word vectors (starter, not semantic embeddings).
# local_openai = /embeddings on the same loopback API; set its model below.
STUDYBOOK_EMBEDDING_MODE=lexical
STUDYBOOK_EMBEDDING_MODEL=local-embedding-model
STUDYBOOK_DATA_DIR=.studybook
